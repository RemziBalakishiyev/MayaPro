{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.{svg,png,jpg,jpeg,gif,ico,webp,woff,woff2,ttf}"]
  },
  "routes": [
    {
      "route": "/assets/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/index.html",
      "headers": { "cache-control": "no-cache" }
    }
  ]
}
